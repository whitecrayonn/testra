# Testra local development environment
# Copy to .env and adjust as needed. Never commit real secrets.

ENV=development
PORT=8080

# PostgreSQL (local native service — see ADR-009)
DATABASE_URL=postgres://testra:testra@localhost:5432/testra?sslmode=disable
MIGRATIONS_PATH=apps/api/migrations

# Auth
JWT_ISSUER=testra
JWT_AUDIENCE=testra-api
JWT_PRIVATE_KEY_FILE=
JWT_PUBLIC_KEY_FILES=
JWT_EXPIRY_MINUTES=15
REFRESH_EXPIRY_DAYS=30
REFRESH_ABSOLUTE_DAYS=90

# Redis (optional; leave blank for local in-memory rate limiting)
REDIS_ADDR=localhost:6379

# SMTP (Mailpit local)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@testra.local
SMTP_USERNAME=
SMTP_PASSWORD_SECRET=SMTP_PASSWORD

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Web app origin, used to build the password-reset magic link sent by email
WEB_BASE_URL=http://localhost:3000

# ML Service
ML_SERVICE_URL=http://localhost:8000
# Optional shared secret between the Go API and the ML service; must match
# ML_API_KEY below if either is set.
ML_API_KEY=
# Required only for Test Cases > Generate > "Upload Test Cases" (LLM-based
# generation from an uploaded Excel/CSV). Leave blank to disable that one
# feature; every other part of Testra stays LLM-free. Get a free key at
# https://aistudio.google.com/apikey.
GEMINI_API_KEY=

# Stripe (optional; leave blank to use local billing records)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=

# Worker
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_CLEANUP_INTERVAL_SECONDS=300
WORKER_JOB_RETENTION_HOURS=24

# Web
NEXT_PUBLIC_API_URL=http://localhost:8080
